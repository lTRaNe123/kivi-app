<ChevronOrdersScreen>:
    AppPageLayout:
        orientation: "vertical"
        padding: dp(18), dp(22)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.965, 0.965, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(44)

            SecondaryButton:
                text: "Назад"
                size_hint_x: None
                width: dp(92)
                on_release: root.goto_voentorg()

            Label:
                text: "Мои заказы"
                color: 0.04, 0.04, 0.04, 1
                bold: True
                font_size: "25sp"
                halign: "center"
                valign: "middle"
                text_size: self.size

            SecondaryButton:
                text: "Обновить"
                size_hint_x: None
                width: dp(104)
                on_release: root.load_orders()

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(6)

            Button:
                text: "Все"
                background_normal: ""
                background_down: ""
                bold: True
                font_size: "13sp"
                background_color: (0.45, 0.50, 0.30, 1) if root.active_filter == "" else (0.86, 0.86, 0.84, 1)
                color: (1, 1, 1, 1) if root.active_filter == "" else (0.08, 0.08, 0.08, 1)
                on_release: root.select_filter("")

            Button:
                text: "Активные"
                background_normal: ""
                background_down: ""
                bold: True
                font_size: "13sp"
                background_color: (0.45, 0.50, 0.30, 1) if root.active_filter == "active" else (0.86, 0.86, 0.84, 1)
                color: (1, 1, 1, 1) if root.active_filter == "active" else (0.08, 0.08, 0.08, 1)
                on_release: root.select_filter("active")

            Button:
                text: "Черновики"
                background_normal: ""
                background_down: ""
                bold: True
                font_size: "13sp"
                background_color: (0.45, 0.50, 0.30, 1) if root.active_filter == "drafts" else (0.86, 0.86, 0.84, 1)
                color: (1, 1, 1, 1) if root.active_filter == "drafts" else (0.08, 0.08, 0.08, 1)
                on_release: root.select_filter("drafts")

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(6)

            Button:
                text: "Завершённые"
                background_normal: ""
                background_down: ""
                bold: True
                font_size: "13sp"
                background_color: (0.45, 0.50, 0.30, 1) if root.active_filter == "completed" else (0.86, 0.86, 0.84, 1)
                color: (1, 1, 1, 1) if root.active_filter == "completed" else (0.08, 0.08, 0.08, 1)
                on_release: root.select_filter("completed")

        RecycleView:
            id: orders_list
            viewclass: "ChevronOrderListRow"
            scroll_type: ["bars", "content"]
            bar_width: dp(4)

            RecycleBoxLayout:
                default_size: None, dp(104)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: "vertical"
                spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(8)

            FinePrint:
                text: "Загрузка..." if root.loading else root.status_text
                color: 0.34, 0.34, 0.34, 1

            SecondaryButton:
                text: "Ещё"
                size_hint_x: None
                width: dp(82)
                disabled: root.loading or not root.has_more
                on_release: root.load_more()


<ChevronOrderDetailScreen>:
    AppPageLayout:
        orientation: "vertical"
        padding: dp(18), dp(22)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.965, 0.965, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(44)

            SecondaryButton:
                text: "Назад"
                size_hint_x: None
                width: dp(92)
                on_release: root.goto_orders()

            Label:
                text: root.title_text
                color: 0.04, 0.04, 0.04, 1
                bold: True
                font_size: "21sp"
                halign: "center"
                valign: "middle"
                text_size: self.size

            SecondaryButton:
                text: "Обновить"
                size_hint_x: None
                width: dp(104)
                on_release: root.load_detail()

        ScrollView:
            bar_width: dp(4)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(186) + stage_steps_box.height

                    SectionLabel:
                        text: root.status_text

                    FinePrint:
                        text: root.progress_text
                        color: 0.45, 0.50, 0.30, 1

                    BoxLayout:
                        id: stage_steps_box
                        orientation: "horizontal"
                        spacing: dp(6)
                        size_hint_y: None
                        height: dp(42)

                    FinePrint:
                        text: root.test_text
                        color: 0.45, 0.50, 0.30, 1

                    FinePrint:
                        text: root.kit_text
                        color: 0.28, 0.28, 0.28, 1

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(148)

                    SectionLabel:
                        text: "Параметры"

                    FinePrint:
                        text: root.config_text
                        color: 0.28, 0.28, 0.28, 1

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(136)

                    SectionLabel:
                        text: "Фамилии / позывные"

                    FinePrint:
                        text: root.lines_text
                        color: 0.28, 0.28, 0.28, 1

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(112)

                    SectionLabel:
                        text: root.price_text

                    FinePrint:
                        text: root.payment_text
                        color: 0.28, 0.28, 0.28, 1

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(92)

                    SectionLabel:
                        text: "Комментарий"

                    FinePrint:
                        text: root.comment_text
                        color: 0.28, 0.28, 0.28, 1

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(150)

                    SectionLabel:
                        text: "История"

                    FinePrint:
                        text: root.history_text
                        color: 0.28, 0.28, 0.28, 1

        FinePrint:
            text: "Загрузка..." if root.loading else root.error_text
            color: 0.34, 0.34, 0.34, 1
            size_hint_y: None
            height: dp(28)

        Button:
            text: "Продолжить оформление"
            background_normal: ""
            background_down: ""
            background_color: 0.45, 0.50, 0.30, 1
            color: 1, 1, 1, 1
            bold: True
            font_size: "15sp"
            size_hint_y: None
            height: dp(50)
            opacity: 1 if root.is_draft else 0
            disabled: root.loading or not root.is_draft
            on_release: root.continue_draft()


