                size_hint_x: None
                width: dp(92)
                on_release: root.goto_employee()

            Label:
                text: root.role_title
                color: 0.04, 0.04, 0.04, 1
                bold: True
                font_size: "22sp"
                halign: "center"
                valign: "middle"
                text_size: self.size

            SecondaryButton:
                text: "Обновить"
                size_hint_x: None
                width: dp(104)
                on_release: root.load_orders()

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)

            AppTextInput:
                id: employee_search
                hint_text: "Поиск CHV-..."
                multiline: False

            SecondaryButton:
                text: "Найти"
                size_hint_x: None
                width: dp(86)
                on_release: root.load_orders()

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(6)

            Button:
                text: "Новые"
                background_normal: ""
                background_down: ""
                background_color: (0.10, 0.22, 0.42, 1) if root.queue_mode == "new" else (0.88, 0.90, 0.94, 1)
                color: (1, 1, 1, 1) if root.queue_mode == "new" else (0.06, 0.06, 0.06, 1)
                bold: True
                font_size: "13sp"
                on_release: root.set_queue_mode("new")

            Button:
                text: "Мои"
                background_normal: ""
                background_down: ""
                background_color: (0.10, 0.22, 0.42, 1) if root.queue_mode == "mine" else (0.88, 0.90, 0.94, 1)
                color: (1, 1, 1, 1) if root.queue_mode == "mine" else (0.06, 0.06, 0.06, 1)
                bold: True
                font_size: "13sp"
                on_release: root.set_queue_mode("mine")

            Button:
                text: "Завершил"
                background_normal: ""
                background_down: ""
                background_color: (0.10, 0.22, 0.42, 1) if root.queue_mode == "completed" else (0.88, 0.90, 0.94, 1)
                color: (1, 1, 1, 1) if root.queue_mode == "completed" else (0.06, 0.06, 0.06, 1)
                bold: True
                font_size: "13sp"
                on_release: root.set_queue_mode("completed")

        RecycleView:
            id: employee_orders_list
            viewclass: "ChevronOrderListRow"
            scroll_type: ["bars", "content"]
            bar_width: dp(4)

            RecycleBoxLayout:
                default_size: None, dp(104)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: "vertical"
                spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(8)

            FinePrint:
                text: "Загрузка..." if root.loading else root.status_text
                color: 0.34, 0.34, 0.34, 1

            SecondaryButton:
                text: "Ещё"
                size_hint_x: None
                width: dp(82)
                disabled: root.loading or not root.has_more
                on_release: root.load_more()


<EmployeeOrderDetailScreen>:
    AppPageLayout:
        orientation: "vertical"
        padding: dp(16), dp(18)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.965, 0.965, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(52) + max(dp(30), employee_order_title.texture_size[1] + dp(8))
            spacing: dp(2)

            BoxLayout:
                size_hint_y: None
                height: dp(52)

                SecondaryButton:
                    text: "‹"
                    font_size: "24sp"
                    size_hint_x: None
                    width: dp(52)
                    on_release: root.goto_queue()

                Widget:

                SecondaryButton:
                    text: "↻"
                    font_size: "20sp"
                    size_hint_x: None
                    width: dp(52)
                    on_release: root.load_detail()

            Label:
                id: employee_order_title
                text: root.title_display
                color: 0.04, 0.04, 0.04, 1
                bold: True
                font_size: "19sp"
                halign: "center"
                valign: "middle"
                max_lines: 2
                text_size: self.width, None
                size_hint_y: None
                height: max(dp(30), self.texture_size[1] + dp(8))

        ScrollView:
            bar_width: dp(4)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: 0, 0, 0, dp(70) if root.action_text else dp(8)

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(8)

                    SectionLabel:
                        text: root.status_text if root.status_text else "Вышивка"
                        font_size: "18sp"

                    FinePrint:
                        text: root.test_text
                        color: 0.45, 0.50, 0.30, 1
                        size_hint_y: None
                        text_size: self.width, None
                        height: self.texture_size[1] if root.test_text else 0
                        opacity: 1 if root.test_text else 0

                    FinePrint:
                        text: root.created_text
                        color: 0.28, 0.28, 0.28, 1
                        size_hint_y: None
                        text_size: self.width, None
                        height: self.texture_size[1]

                    FinePrint:
                        text: "Комплект: " + root.kit_text
                        color: 0.28, 0.28, 0.28, 1
                        size_hint_y: None
                        text_size: self.width, None
                        height: self.texture_size[1]

                    FinePrint:
                        text: root.action_hint
                        color: 0.70, 0.20, 0.20, 1
                        size_hint_y: None
                        text_size: self.width, None
                        height: self.texture_size[1] if root.action_hint else 0
                        opacity: 1 if root.action_hint else 0

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(10)

                    SectionLabel:
                        text: "Параметры"
                        font_size: "18sp"

                    BoxLayout:
                        id: employee_params_box
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(8)

                    SectionLabel:
                        text: "Фамилии / позывные"
                        font_size: "18sp"

                    BoxLayout:
                        id: employee_lines_box
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(8)

                    SectionLabel:
                        text: "Комментарий"
                        font_size: "18sp"

                    BoxLayout:
                        id: employee_comment_box
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height

                CardBox:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(8)

                    SectionLabel:
                        text: "История"
                        font_size: "18sp"

                    BoxLayout:
                        id: employee_history_box
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(6)

        FinePrint:
            text: "Загрузка..." if root.loading else root.error_text
            color: 0.34, 0.34, 0.34, 1
            size_hint_y: None
            height: dp(30)

        BoxLayout:
            size_hint_y: None
            height: dp(56) if root.action_text else 0
            padding: dp(16), 0
            opacity: 1 if root.action_text else 0

            PrimaryButton:
                text: "Загрузка..." if root.action_loading else root.action_text
                height: dp(54)
                disabled: root.loading or root.action_loading or not root.action_enabled
                on_release: root.run_action()


