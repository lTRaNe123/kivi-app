            color: 1, 1, 1, 1
            bold: True
            size_hint: None, None
            width: dp(82)
            height: dp(44)
            on_release: root.goto_names()

        Label:
            text: root.title_text
            color: 1, 1, 1, 1
            bold: True
            font_size: "21sp"
            halign: "left"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: dp(44)

        Label:
            text: root.summary_text
            color: 0.78, 0.83, 0.90, 1
            font_size: "13sp"
            halign: "left"
            valign: "top"
            text_size: self.size
            size_hint_y: None
            height: dp(132)

        Label:
            text: "Фамилии / позывные"
            color: 1, 1, 1, 1
            bold: True
            font_size: "16sp"
            halign: "left"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: dp(26)

        Label:
            text: root.lines_text
            color: 0.82, 0.86, 0.92, 1
            font_size: "14sp"
            halign: "left"
            valign: "top"
            text_size: self.size

        Label:
            text: root.price_text
            color: 0.45, 0.50, 0.30, 1
            bold: True
            font_size: "15sp"
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: dp(52)

        Label:
            text: root.pricing_label
            color: 0.45, 0.50, 0.30, 1
            bold: True
            font_size: "13sp"
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: dp(26)

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(8)

            Button:
                text: "Рубли"
                background_normal: ""
                background_down: ""
                background_color: (0.45, 0.50, 0.30, 1) if root.payment_method == "RUB" else (0.88, 0.88, 0.84, 1)
                color: (1, 1, 1, 1) if root.payment_method == "RUB" else (0.05, 0.05, 0.05, 1)
                bold: True
                font_size: "13sp"
                on_release: root.set_payment_method("RUB")

            Button:
                text: "СТ"
                background_normal: ""
                background_down: ""
                background_color: (0.45, 0.50, 0.30, 1) if root.payment_method == "ST" else (0.88, 0.88, 0.84, 1)
                color: (1, 1, 1, 1) if root.payment_method == "ST" else (0.05, 0.05, 0.05, 1)
                bold: True
                font_size: "13sp"
                on_release: root.set_payment_method("ST")

        AppTextInput:
            text: root.comment_text
            hint_text: "Комментарий к заказу"
            multiline: False
            font_size: "14sp"
            on_text: root.comment_text = self.text

        Label:
            text: root.draft_status_text
            color: 0.45, 0.50, 0.30, 1
            font_size: "13sp"
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: dp(42)

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(8)

            Button:
                text: root.save_button_text
                background_normal: ""
                background_down: ""
                background_color: (0.45, 0.50, 0.30, 1) if root.saved else (0.88, 0.88, 0.84, 1)
                color: (1, 1, 1, 1) if root.saved else (0.05, 0.05, 0.05, 1)
                bold: True
                font_size: "13sp"
                disabled: root.saving or root.saved or root.checking_out
                on_release: root.save_draft()

            Button:
                text: root.checkout_button_text
                background_normal: ""
                background_down: ""
                background_color: 0.45, 0.50, 0.30, 1
                color: 1, 1, 1, 1
                bold: True
                font_size: "13sp"
                disabled: root.saving or root.checking_out
                on_release: root.create_test_order()


